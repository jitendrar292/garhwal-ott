{
  "version": 2,
  "buildCommand": "cd server && npm install && cd ../client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/server.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/push/cron/morning-news", "schedule": "30 3 * * *" },
    { "path": "/api/push/cron/evening", "schedule": "30 12 * * *" }
  ]
}
