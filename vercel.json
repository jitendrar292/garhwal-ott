{
  "version": 2,
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "server/src/index.js": {
      "runtime": "@vercel/node"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/server/src/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
